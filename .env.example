# Server-only. Never prefix keys with NEXT_PUBLIC_ or VITE_.
AI_KEY_GEMINI=
AI_KEY_GROQ=
# Approved source services use public read-only APIs; no source key is required.
# Empty/missing AI_MODELS uses config/ai-models.json (Gemini, Groq).
# Set AI_MODELS=[] explicitly to disable all external providers.
AI_MODELS=
AI_KEY_PRIMARY=
# Replace YOUR_MODEL_ID after your team chooses a model:
# AI_MODELS=[{"id":"primary","label":"نموذج الفريق","provider":"openai-compatible","model":"YOUR_MODEL_ID","keyEnv":"AI_KEY_PRIMARY","baseUrl":"https://api.openai.com/v1","jsonMode":true}]
# Anthropic: provider=anthropic, baseUrl=https://api.anthropic.com/v1
# Compatible providers expecting max_tokens: add "tokenParameter":"max_tokens".

# شجرة الأسانيد — إعداد المساعد على هذا الجهاز فقط
# انسخ هذا الملف باسم API.env. SETUP.cmd ينشئ النسخة تلقائياً.
# ضع مفتاحك بعد علامة = ثم احفظ وأعد تشغيل الموقع.
# اترك المفاتيح فارغة لتجربة الإجابات من مصادر المشروع دون نموذج خارجي.
AI_KEY_GEMINI=
AI_KEY_GROQ=

# الإعدادات الافتراضية للموديلات في config/ai-models.json.
# اترك AI_MODELS فارغاً لاستخدامها، أو ضع [] لتعطيل كل المزودين الخارجيين.
AI_MODELS=
AI_KEY_PRIMARY=

# مثال بديل اختياري. استبدل model وbaseUrl وفق مزودك، وأزل # من السطر.
# AI_MODELS=[{"id":"primary","label":"نموذج الفريق","provider":"openai-compatible","model":"YOUR_MODEL_ID","keyEnv":"AI_KEY_PRIMARY","baseUrl":"https://api.openai.com/v1","jsonMode":true}]
# لا ترفع API.env أو .env على GitHub، ولا تسبق المفتاح بـ NEXT_PUBLIC_ أو VITE_.

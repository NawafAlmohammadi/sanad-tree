# API settings for this device.
# SETUP.cmd creates API.env from this template, or copy it manually.
# Add your own key after =, save the file, and restart the server.
# REQUIRED for AI features: add a valid key for at least one provider.
AI_KEY_GEMINI=
AI_KEY_GROQ=

# Default provider/model settings are in config/ai-models.json.
# Leave AI_MODELS empty for defaults, or use [] to disable external providers.
AI_MODELS=
AI_KEY_PRIMARY=

# Optional custom provider example. Replace model/baseUrl and remove # to use.
# AI_MODELS=[{"id":"primary","label":"Custom model","provider":"openai-compatible","model":"YOUR_MODEL_ID","keyEnv":"AI_KEY_PRIMARY","baseUrl":"https://api.openai.com/v1","jsonMode":true}]
# Keep API.env and .env out of GitHub. Do not use NEXT_PUBLIC_ or VITE_ for keys.

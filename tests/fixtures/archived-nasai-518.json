      "reliability": {
        "narratorId": "said-amir-dubai",
        "status": "trusted",
        "text": "ابن حجر: ثقة صالح؛ أبو حاتم: صدوق وفي حديثه بعض الغلط؛ البخاري: كثير الغلط. لا يلغي التوثيق هذه الأقوال.",
        "sourceIds": [
          "sunnah-rijal-3349"
        ]
      }
    },
    {
